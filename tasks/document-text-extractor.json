      "input": {
        "urls": [
          "https://raw.githubusercontent.com/lergassy/apify-actor-assets/main/document-text-extractor/sample-scan.pdf"
        ],
        "ocrScannedPages": true,
        "ocrLanguage": "eng",
        "ocrMaxPagesPerDocument": 20
      },
      "datasetView": "overview",
      "inputSchemaFields": [
        "urls",
        "ocrScannedPages",
        "ocrLanguage",
        "ocrMaxPagesPerDocument"
      ]
    },
    {
      "name": "extract-text-from-several-documents",
